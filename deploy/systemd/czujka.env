# /etc/czujka/czujka.env - environment of the czujka service (mode 0640, owner root:czujka).
# The full list of variables: docs/WDROZENIE.md, section 3.

# PostgreSQL 17 with pg_tde (Percona Distribution for PostgreSQL 17).
CZUJKA_DB_URL=postgres://czujka:CHANGE-ME@127.0.0.1:5432/czujka?sslmode=disable
# require: refuse to start without pg_tde; auto: start and warn; off.
CZUJKA_TDE=require

# Master key of the field-level encryption. Empty: a key file is created in
# /var/lib/czujka/master.key on the first start. Keep a copy of it.
CZUJKA_MASTER_KEY=
CZUJKA_MASTER_KEY_FILE=/var/lib/czujka/master.key

# First administrator (created at the first start). Empty password: a random
# one is printed once in the journal (journalctl -u czujka).
CZUJKA_ADMIN_EMAIL=admin@czujka.local
CZUJKA_ADMIN_PASSWORD=

# Listen on localhost behind a TLS reverse proxy (Caddy, nginx).
CZUJKA_LISTEN=127.0.0.1:8080
CZUJKA_TRUST_PROXY=false
CZUJKA_COOKIE_SECURE=auto

# Operator lock: the networks Czujka may scan. Recommended.
CZUJKA_ALLOWED_NETWORKS=

CZUJKA_TZ=Europe/Warsaw
CZUJKA_LOG_FORMAT=json
# nmap uses raw sockets through the ambient capabilities of the unit.
NMAP_PRIVILEGED=1
