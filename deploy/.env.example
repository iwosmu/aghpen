# Czujka: secrets and settings for deploy/docker-compose.yml.
# Copy this file to deploy/.env and set your own values. deploy/.env is ignored by git.

# Password of the PostgreSQL role. The database has no published port.
CZUJKA_DB_PASSWORD=change-me-long-random

# First administrator, created at the first start.
# Leave the password empty to get a random one printed once in the log:
#   docker compose -f deploy/docker-compose.yml logs czujka | grep -A3 "first administrator"
CZUJKA_ADMIN_EMAIL=admin@czujka.local
CZUJKA_ADMIN_PASSWORD=

# Master key of the field-level encryption (32 random bytes, base64).
# Make one with: docker compose -f deploy/docker-compose.yml run --rm --no-deps czujka genkey
# Empty: a key is generated into the czujka-keys volume on the first start.
CZUJKA_MASTER_KEY=
# Key rotation: put the previous key(s) here (comma separated), set the new key above,
# run "czujka rotate-key", then empty this value again.
CZUJKA_MASTER_KEY_OLD=

# require = refuse to start when pg_tde does not encrypt the tables; auto = start and report; off.
CZUJKA_TDE=require

# Kernel packet cap (nftables in the container's own network namespace): a
# second limit under nmap's pacing that drops probe packets over max_pps x 1.1.
# auto = install when possible; require = refuse to scan without it; off.
CZUJKA_KERNEL_CAP=auto
# Hosts the rotating deep pass (the rest of 1-65535) takes per run of a scope over 256 addresses: 0 = off, max 64.
CZUJKA_DEEP_PASS_HOSTS=16

# Where the UI and the API listen on the host.
CZUJKA_BIND=127.0.0.1
CZUJKA_PORT=8080

# true when Czujka is behind a TLS reverse proxy (Secure cookie, X-Forwarded-For).
CZUJKA_COOKIE_SECURE=auto
CZUJKA_TRUST_PROXY=false

# Operator lock: comma-separated CIDRs. When set, nothing outside them can be
# scanned, and no user (also no administrator) can widen it in the UI or API.
CZUJKA_ALLOWED_NETWORKS=

CZUJKA_TZ=Europe/Warsaw
CZUJKA_VERSION=dev
