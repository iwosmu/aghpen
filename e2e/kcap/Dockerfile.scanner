# The scanner of the kernel-cap experiment: the runtime of deploy/Dockerfile
# (alpine, nmap and nft with file capabilities, user 10001) plus tcpdump, and
# a czujka binary built for linux. Build context: a directory with this file
# and the binary "czujka" (run.sh prepares it).
FROM alpine:3.22
RUN apk add --no-cache nmap nftables tcpdump libcap \
 && addgroup -S -g 10001 czujka && adduser -S -u 10001 -G czujka -h /var/lib/czujka czujka \
 && setcap cap_net_raw,cap_net_admin+eip "$(readlink -f /usr/bin/nmap)" \
 && chgrp czujka "$(readlink -f /usr/sbin/nft)" && chmod 0750 "$(readlink -f /usr/sbin/nft)" \
 && setcap cap_net_admin+ep "$(readlink -f /usr/sbin/nft)"
COPY czujka /usr/local/bin/czujka
USER czujka:czujka
ENV NMAP_PRIVILEGED=1
CMD ["sleep", "infinity"]
